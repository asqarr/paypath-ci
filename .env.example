# Local proof-of-value defaults. Never put real credentials in this file.
PAYPATH_DEMO_MODE=fixed
PAYPATH_DEMO_SCENARIO=successful-payment

# Optional read-only Stripe Test Mode integration.
# Must be an sk_test_ key. Live keys are rejected by the CLI.
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
PAYPATH_STRIPE_SUBSCRIPTION_ID=
PAYPATH_STRIPE_SUBSCRIPTION_ID_SUCCESSFUL_PAYMENT=
PAYPATH_STRIPE_SUBSCRIPTION_ID_CANCELLATION=
PAYPATH_STRIPE_SUBSCRIPTION_ID_DUPLICATE_WEBHOOK=
PAYPATH_WEBHOOK_EVENT_ID_DUPLICATE_WEBHOOK=

# Optional Supabase test project. Use a dedicated, disposable project only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
PAYPATH_TEST_USER_ID=
PAYPATH_TEST_USER_ID_SUCCESSFUL_PAYMENT=
PAYPATH_TEST_USER_ID_CANCELLATION=
PAYPATH_TEST_USER_ID_DUPLICATE_WEBHOOK=
PAYPATH_TEST_SUPABASE_REF=
# Required acknowledgment for integration reads/writes. Use only a disposable test project.
PAYPATH_SUPABASE_TEST_PROJECT_ACK=disposable-test-project
PAYPATH_RUN_SUPABASE_INTEGRATION=0

# Demo app URL for actual authorization checks.
PAYPATH_DEMO_BASE_URL=http://localhost:3000
STRIPE_WEBHOOK_SECRET=
